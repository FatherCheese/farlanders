		"recipesReady": [
			"cookie.farlanders.core.FarlandersRecipes"
		],
		"client": [
			"cookie.farlanders.client.FarlandersClient"
		],
		"beforeClientStart": [
			"cookie.farlanders.client.FarlandersClient"
		],
		"afterClientStart": [
			"cookie.farlanders.client.FarlandersClient"
		],
		"initModels": [
			"cookie.farlanders.client.render.FarlandersModels"
		]
	},
	"mixins": [
		"farlanders.mixins.json"
	],

	"depends": {
		"minecraft": "*",
