{
	"schemaVersion": 1,
	"id": "farlanders",
	"version": "${version}",

	"name": "Farlanders",
	"description": "This mod adds new monsters to scare you.",
	"authors": [
		"Cookie Cakes"
	],
	"contributors": [
		"Apollo",
		"Scaldings",
		"Pain",
		"Useless"
	],
	"contact": {
		"homepage": "",
		"sources": ""
	},

	"icon": "assets/farlanders/icon.png",
	"license": "CC0-1.0",

	"environment": "*",
	"entrypoints": {
		"main": [
			"cookie.farlanders.core.Farlanders"
		],
		"beforeGameStart": [
			"cookie.farlanders.core.Farlanders"
		],
		"afterGameStart": [
			"cookie.farlanders.core.Farlanders"
		],
		"afterBlockInit": [
			"cookie.farlanders.core.block.FarlandersBlocks"
